# Copy to .env at the repo root. Read by apps/api and packages/db scripts.
# The Next apps read their own apps/<app>/.env.local (only API_ORIGIN / NEXT_PUBLIC_* there).

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Postgres. `docker compose up -d` starts one on port 55432.
DATABASE_URL=postgres://predict:predict@localhost:55432/predict

# Redis (optional). Shares rate limits between API instances and keeps them across restarts.
REDIS_URL=redis://localhost:56379

WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001

# Signs session tokens and keys OTP/IP hashes. 32+ random characters, different from any other
# app on scoutgram.africa. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Encrypts bank account numbers and admin authenticator secrets. 32 bytes, base64. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing it makes stored account numbers unreadable: keep it in your secret manager.
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEY_ID=k1

# Staff must turn on authenticator-app sign-in. Defaults to true in production.
ADMIN_MFA_REQUIRED=false

# SMS: `console` (development) logs codes to the API output instead of texting.
#   termii          → TERMII_API_KEY (+ approved sender ID with the DND route enabled)
#   bulksmsnigeria  → BULKSMSNIGERIA_API_TOKEN (+ approved sender ID)
SMS_PROVIDER=console
SMS_SENDER_ID=Scoutgram
TERMII_API_KEY=
TERMII_BASE_URL=https://api.ng.termii.com
BULKSMSNIGERIA_API_TOKEN=
# Sandbox (no real texts, no charge): https://www.bulksmsnigeria.com/api/sandbox/v2
BULKSMSNIGERIA_BASE_URL=https://www.bulksmsnigeria.com/api/v2
# Hard cap on texts per rolling 24 hours (limits the damage of SMS-pumping abuse).
SMS_DAILY_CAP=5000

# Cloudflare Turnstile on "text me a code" (empty = off). The site key goes in
# apps/web/.env.local as NEXT_PUBLIC_TURNSTILE_SITE_KEY.
TURNSTILE_SECRET_KEY=

# Logos. "local" keeps uploads in apps/api/.storage and serves them from the API.
# "r2" uses a PUBLIC Cloudflare R2 bucket (production).
STORAGE_DRIVER=local
STORAGE_KEY_PREFIX=predict/
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Optional
SENTRY_DSN=

# Behind a proxy/CDN, how many hops to trust for the client IP (rate limits).
TRUST_PROXY=1

# Seconds between background ticks (auto-open/close days, SMS outbox). 0 turns it off.
TICKER_INTERVAL_SEC=20

# ---------------------------------------------------------------------------------------------
# apps/web/.env.local
#   API_ORIGIN=http://localhost:4000
#   NEXT_PUBLIC_SITE_URL=http://localhost:3000
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=
#   NEXT_PUBLIC_SENTRY_DSN=
# apps/admin/.env.local
#   API_ORIGIN=http://localhost:4000
#   NEXT_PUBLIC_SENTRY_DSN=
